# Local config template — copy to:
#   $XDG_CONFIG_HOME/ouro-spotify-playlist-export/config.toml
# Prefer: ouro-spe setup
#
# Register this redirect in the Spotify Dashboard EXACTLY
# (localhost is not allowed):
#   http://127.0.0.1:4389/callback

SPOTIFY_CLIENT_ID = "<CLIENT_ID>"
SPOTIFY_REDIRECT_URI = "http://127.0.0.1:4389/callback"
